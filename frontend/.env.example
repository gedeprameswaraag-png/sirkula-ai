# Alamat backend Express
VITE_API_URL=http://localhost:5000
# Path endpoint analisis (route di aiRoutes.js adalah /test; sesuaikan prefix di server.js)
VITE_ANALYZE_PATH=/api/ai/test
# Nama field file pada multer, mis. upload.single('image')
VITE_IMAGE_FIELD=image
# true = pakai hasil AI palsu (untuk uji UI tanpa memakai kuota Gemini)
VITE_MOCK_AI=false
